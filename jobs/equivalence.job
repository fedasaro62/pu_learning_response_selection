#!/bin/bash
#SBATCH --job-name=equiv_check
#SBATCH --mail-type=ALL
#SBATCH --mail-user=msteams:dasaro
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --partition=A100
#SBATCH --gpus=3g.40gb:1
#SBATCH --output=logs/equivalence/%j.out

# under sbatch $0 is a spooled copy, so rely on the submit dir (submit_all.sh cds to the repo root)
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
scripts/check_equivalence.sh
