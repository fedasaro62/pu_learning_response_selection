#!/bin/bash
#SBATCH --job-name=train_main
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --partition=A100
#SBATCH --gpus=3g.40gb:1
#SBATCH --array=0-17%4
#SBATCH --output=logs/train_main/%A_%a.out

# under sbatch $0 is a spooled copy, so rely on the submit dir (submit_all.sh cds to the repo root)
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
source "${PU_VENV:-.venv}/bin/activate"
CONFIGS=(
  "ubuntu supervised exact 0"
  "ubuntu supervised exact 1"
  "ubuntu supervised exact 2"
  "e_commerce supervised exact 0"
  "e_commerce supervised exact 1"
  "e_commerce supervised exact 2"
  "ubuntu pu zero 0"
  "ubuntu pu zero 1"
  "ubuntu pu zero 2"
  "e_commerce pu zero 0"
  "e_commerce pu zero 1"
  "e_commerce pu zero 2"
  "ubuntu pu exact 0"
  "ubuntu pu exact 1"
  "ubuntu pu exact 2"
  "e_commerce pu exact 0"
  "e_commerce pu exact 1"
  "e_commerce pu exact 2"
)
read -r TASK OBJECTIVE PRIOR SEED <<< "${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
echo "config: task=$TASK objective=$OBJECTIVE prior=$PRIOR seed=$SEED"
scripts/finetune.sh "$TASK" "$OBJECTIVE" "$PRIOR" "$SEED" 0.8
