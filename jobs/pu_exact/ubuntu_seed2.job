#!/bin/bash
#SBATCH --job-name=ubuntu_pu_exact_seed2
#SBATCH --mail-type=ALL
#SBATCH --mail-user=msteams:dasaro
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --partition=A100
#SBATCH --gpus=3g.40gb:1
#SBATCH --output=logs/pu_exact/ubuntu_seed2.out

# under sbatch $0 is a spooled copy, so rely on the submit dir (submit_all.sh cds to the repo root)
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/../..}"
source /nfs/home/dasaro/research/innonext-BERT_FP/.venv/bin/activate
scripts/finetune.sh ubuntu pu exact 2 0.8
