#!/bin/bash
#SBATCH --job-name=train_est
#SBATCH --mail-type=ALL
#SBATCH --mail-user=msteams:dasaro
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --partition=A100
#SBATCH --gpus=3g.40gb:1
#SBATCH --array=0-5%4
#SBATCH --output=logs/train_estimated/%A_%a.out

# under sbatch $0 is a spooled copy, so rely on the submit dir (submit_all.sh cds to the repo root)
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
source /nfs/home/dasaro/research/innonext-BERT_FP/.venv/bin/activate
CONFIGS=(
  "ubuntu pu estimated 0"
  "ubuntu pu estimated 1"
  "ubuntu pu estimated 2"
  "e_commerce pu estimated 0"
  "e_commerce pu estimated 1"
  "e_commerce pu estimated 2"
)
read -r TASK OBJECTIVE PRIOR SEED <<< "${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
echo "config: task=$TASK objective=$OBJECTIVE prior=$PRIOR seed=$SEED"
scripts/finetune.sh "$TASK" "$OBJECTIVE" "$PRIOR" "$SEED" 0.8
