#!/bin/bash
#SBATCH --job-name=est_prior
#SBATCH --mail-type=ALL
#SBATCH --mail-user=msteams:dasaro
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --partition=A100
#SBATCH --gpus=3g.40gb:1
#SBATCH --array=0-1
#SBATCH --output=logs/estimate_prior/%A_%a.out

# under sbatch $0 is a spooled copy, so rely on the submit dir (submit_all.sh cds to the repo root)
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
source /nfs/home/dasaro/research/innonext-BERT_FP/.venv/bin/activate
CONFIGS=(
  "ubuntu"
  "e_commerce"
)
read -r TASK <<< "${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
echo "config: task=$TASK"
scripts/estimate_prior.sh "$TASK" 0.8
